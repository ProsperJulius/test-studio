{
  "name": "test-studio",
  "productName": "Test Studio",
  "version": "1.0.0",
  "description": "Desktop studio for recording, running and evidencing regression tests without code",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node test/e2e/run.js",
    "test:parity": "node test/e2e/locators-parity.js",
    "test:pw-parity": "node test/e2e/pw-locator-parity.js",
    "test:recorder": "node test/e2e/recorder-locators.js",
    "test:recorder-tree": "node test/e2e/recorder-tree.js",
    "test:live-aggrid": "node test/e2e/live-ag-grid.js",
    "fixture": "node test/fixture/server.js",
    "regression": "node bin/test-studio.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "docx": "^9.5.0",
    "js-yaml": "^4.1.0",
    "playwright-core": "1.55.0"
  },
  "devDependencies": {
    "ag-grid-community": "32.3.3",
    "ag-grid-community-36": "npm:ag-grid-community@^36.2.0",
    "ag-grid-enterprise": "^36.2.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.yourcompany.teststudio",
    "productName": "Test Studio",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "bin": {
    "test-studio": "bin/test-studio.js"
  }
}
